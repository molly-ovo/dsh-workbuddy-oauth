# 依赖
node_modules/

# 构建产物
#
# `lib/` 是 tsdown 的输出目录，**有意提交**：这个仓库同时充当可安装的插件包，
# 提交产物才能让 `dsh plugin add <git-url>` 直接可用，不必先装 pnpm 再构建。
# 代价是改完 `src/` 必须重新 `pnpm build` 并一并提交，否则仓库里的产物会落后于源码。
# `dist/` 没有被 tsdown 使用，留作其它工具兜底，仍然忽略。
dist/

# 测试覆盖率（vitest 尚未开 coverage，先占位）
coverage/

# 增量编译缓存
*.tsbuildinfo

# 日志
*.log

# 编辑器 / IDE
.idea/
.vscode/
*.swp

# 系统垃圾文件
Thumbs.db
.DS_Store

# 内部交接文档 —— 不进仓库，只留 README 作为入口
docs/

# 上游参照 clone —— 只读参考，不随仓库分发
.upstream/

# ---------------------------------------------------------------------------
# 运行期状态（含令牌与账号标识）—— 防御性忽略
#
# 这些文件正常只存在于 $DSH_HOME/workbuddy-standalone/，不在仓库内。此处仍
# 逐一列出，是因为一次手滑的复制（调试、备份、截图）就足以把一份含
# accessToken / refreshToken / 账号 uid 的文件送进提交。宁可多写几行。
#
# 判据：凡 src/credentials.ts 的 stateFilePath() 能写出的名字，都在这里。
# ---------------------------------------------------------------------------
accounts/
workbuddy-*.json
probe-*.json
cooldowns.json
disabled-accounts.json
hidden-models.json
task-state.json
preferences.json
compatibility.json

# 凭据 / 环境 / 密钥
.env
.env.*
*.pem
*.key
*.p12
.npmrc
.netrc
settings.yaml
settings.yml

# DSH 本地 profile 数据（可能含已安装插件的清单与凭据）
.workbuddy-probe.json
.dsh/

# 本地手工备份 / 草稿（如 README.bak.md）
README.bak.md
README.old.md
README.orig.md
